@page "/student"
@inject ApiClient Api
@inject AuthState Auth
@inject IJSRuntime JS

<PageTitle>Личный кабинет</PageTitle>

<div class="page-title">
    <div>
        <h1>Личный кабинет студента</h1>
        <p>Доступные тестирования, текущие метрики и персональная обратная связь.</p>
    </div>
</div>

@if (!Auth.IsAuthenticated)
{
    <section class="panel">
        <h2>Нужен вход</h2>
        <p>Сначала войдите в систему.</p>
    </section>
}
else if (!Auth.IsStudent)
{
    <section class="panel">
        <h2>Раздел студента</h2>
        <p>Этот экран предназначен для прохождения тестов студентами.</p>
    </section>
}
else
{
    <div class="grid cols-3">
        <section class="panel">
            <h2>Текущие метрики</h2>
            <p class="muted">Здесь отображается сглаженное значение EMA после всех прохождений.</p>
            @if (metrics.Count == 0)
            {
                <p>Метрики появятся после прохождения теста.</p>
            }
            @foreach (var metric in metrics)
            {
                <div class="metric">
                    <span>@RuText.Fix(metric.MetricName)</span>
                    <strong>@Math.Round(metric.Value, 1)</strong>
                </div>
            }
        </section>

        <section class="panel">
            <h2>Текущие метрики EMA</h2>
            <p class="chart-caption">Диаграмма показывает сглаженные текущие метрики студента после всех прохождений. Цвет учитывает тип метрики: для рисковых высокие значения опаснее, для позитивных наоборот.</p>
            <div class="chart-box compact">
                <canvas id="studentScalesChart"></canvas>
            </div>
        </section>

        <section class="panel">
            <h2>Последний результат теста</h2>
            <p class="muted">Показывает именно последнее прохождение без EMA-сглаживания.</p>
            @if (lastResult == null)
            {
                <p>После отправки теста здесь появятся рассчитанные показатели.</p>
            }
            else
            {
                @foreach (var metric in lastResult.Metrics)
                {
                    <div class="metric">
                        <span>@RuText.Fix(metric.MetricName)</span>
                        <strong>@Math.Round(metric.CurrentValue, 1)</strong>
                    </div>
                }
            }
        </section>
    </div>

    <div class="grid cols-2" style="margin-top:14px">
        <section class="panel">
            <h2>Доступные тестирования</h2>
            @if (tests.Count == 0)
            {
                <p>Сейчас для вашей группы нет открытых тестов.</p>
            }
            @foreach (var test in tests)
            {
                <div class="test-card">
                    <div>
                        <strong>@RuText.Fix(test.TestTitle)</strong>
                        <small>Доступен до @ToLocal(test.ClosesAt).ToString("dd.MM.yyyy HH:mm")</small>
                    </div>
                    <button class="btn-primary" type="button" disabled="@busy" @onclick="() => StartTest(test)">Пройти</button>
                </div>
            }
        </section>

        <section class="panel">
            <h2>Обратная связь</h2>
            <form @onsubmit="SubmitFeedback" @onsubmit:preventDefault>
                <div class="form-grid">
                    <div class="field">
                        <label>Что сейчас беспокоит или помогает?</label>
                        <textarea rows="8" @bind="feedbackText"></textarea>
                    </div>
                    <div class="button-row">
                        <button class="btn-primary" type="submit" disabled="@busy">Отправить</button>
                    </div>
                </div>
            </form>
            @if (feedbackResult != null)
            {
                <div class="metric">
                    <span>Тональность</span>
                    <strong>@Math.Round(feedbackResult.SentimentScore, 1)</strong>
                </div>
                <p>Темы: @string.Join(", ", feedbackResult.Topics.Select(RuText.Fix))</p>
            }
        </section>
    </div>
}

@if (showTestModal && fullTest != null)
{
    <div class="modal-backdrop">
        <section class="modal-panel">
            <div class="modal-head">
                <div>
                    <h2>@RuText.Fix(fullTest.Title)</h2>
                    <p>Ответьте на все вопросы и отправьте тестирование.</p>
                </div>
                <button class="icon-button" type="button" title="Закрыть" @onclick="CloseModal">×</button>
            </div>

            <form @onsubmit="SubmitTest" @onsubmit:preventDefault>
                <div class="modal-body">
                    @foreach (var question in fullTest.Questions)
                    {
                        <div class="question-block">
                            <h3>@RuText.Fix(question.Text)</h3>
                            @foreach (var answer in question.AnswerOptions)
                            {
                                <label class="radio-row">
                                    <input type="radio"
                                           name="@($"q{question.QuestionId}")"
                                           checked="@IsSelected(question.QuestionId, answer.AnswerId)"
                                           @onchange="@(() => SelectAnswer(question.QuestionId, answer.AnswerId))" />
                                    <span>@RuText.Fix(answer.Text)</span>
                                </label>
                            }
                        </div>
                    }
                </div>
                <div class="modal-actions">
                    <button class="btn-secondary" type="button" @onclick="CloseModal">Отмена</button>
                    <button class="btn-primary" type="submit" disabled="@busy">Завершить тест</button>
                </div>
            </form>
        </section>
    </div>
}

@if (!string.IsNullOrWhiteSpace(status))
{
    <section class="panel" style="margin-top:14px">
        <span>@status</span>
    </section>
}

@code {
    private readonly Dictionary<int, int> answers = new();
    private List<TestAssignment> tests = new();
    private List<UserMetric> metrics = new();
    private FullTestResponse? fullTest;
    private ProcessTestResult? lastResult;
    private FeedbackResponse? feedbackResult;
    private string feedbackText = string.Empty;
    private string? status;
    private bool busy;
    private bool chartsPending;
    private bool showTestModal;

    protected override async Task OnInitializedAsync()
    {
        if (Auth.IsStudent)
        {
            await LoadData();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (chartsPending)
        {
            chartsPending = false;
            await RenderCharts();
        }
    }

    private async Task LoadData()
    {
        tests = await Api.GetAvailableTestsAsync();
        metrics = await Api.GetMyMetricsAsync();
        chartsPending = true;
    }

    private async Task StartTest(TestAssignment assignment)
    {
        answers.Clear();
        status = null;
        fullTest = await Api.GetFullTestAsync(assignment.TestId);
        showTestModal = fullTest != null;
        if (fullTest == null)
        {
            status = Api.LastError;
        }
    }

    private void CloseModal()
    {
        showTestModal = false;
        fullTest = null;
        answers.Clear();
    }

    private void SelectAnswer(int questionId, int answerId) => answers[questionId] = answerId;

    private bool IsSelected(int questionId, int answerId) =>
        answers.TryGetValue(questionId, out var selected) && selected == answerId;

    private async Task SubmitTest()
    {
        if (fullTest == null)
        {
            return;
        }

        if (answers.Count != fullTest.Questions.Count)
        {
            status = "Ответьте на все вопросы перед отправкой.";
            return;
        }

        busy = true;
        lastResult = await Api.SubmitCurrentUserTestAsync(new SubmitCurrentUserTest
        {
            TestId = fullTest.TestId,
            Answers = answers.Select(x => new SubmitAnswer { QuestionId = x.Key, AnswerId = x.Value }).ToList()
        });
        status = lastResult == null ? Api.LastError : "Тест завершен, метрики учтены.";
        if (lastResult != null)
        {
            CloseModal();
        }
        await LoadData();
        busy = false;
    }

    private async Task SubmitFeedback()
    {
        if (string.IsNullOrWhiteSpace(feedbackText))
        {
            status = "Введите текст обратной связи.";
            return;
        }

        busy = true;
        feedbackResult = await Api.SubmitFeedbackAsync(feedbackText);
        status = feedbackResult == null ? Api.LastError : "Обратная связь отправлена.";
        feedbackText = string.Empty;
        busy = false;
    }

    private async Task RenderCharts()
    {
        var currentMetrics = metrics
            .OrderBy(x => RuText.Fix(x.MetricName))
            .ToList();

        await JS.InvokeVoidAsync("ptdCharts.bar", "studentScalesChart",
            currentMetrics.Select(x => RuText.Fix(x.MetricName)).ToArray(),
            currentMetrics.Select(x => Math.Round(x.Value, 1)).ToArray(),
            "Текущее значение EMA",
            currentMetrics.Select(x => MetricLevelColor(x.Value, x.IsPositive)).ToArray());
    }

    private static string MetricLevelColor(decimal value, bool isPositive)
    {
        var level = value < 40m
            ? "low"
            : value < 70m
                ? "medium"
                : "high";

        return level switch
        {
            "low" => isPositive ? "#ef4444" : "#22c55e",
            "medium" => "#facc15",
            "high" => isPositive ? "#22c55e" : "#ef4444",
            _ => "#8b5cf6"
        };
    }

    private static DateTime ToLocal(DateTime value) => value.Kind == DateTimeKind.Local
        ? value
        : value.AddHours(5);
}
