@implements IDisposable
@inject AuthState Auth

<div class="brand">
    <div class="brand-mark">IT</div>
    <div>
        <strong>КТК</strong>
        <span>климат учебного коллектива</span>
    </div>
</div>

<nav class="nav-list">
    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">Панель управления</NavLink>

    @if (Auth.IsStudent)
    {
        <NavLink class="nav-link" href="student">Личный кабинет</NavLink>
        <NavLink class="nav-link" href="feedback">Обратная связь</NavLink>
    }

    @if (Auth.IsPsychologist)
    {
        <NavLink class="nav-link" href="groups">Аналитика групп</NavLink>
        <NavLink class="nav-link" href="risks">Группы риска</NavLink>
        <NavLink class="nav-link" href="engagement">Вовлеченность</NavLink>
        <NavLink class="nav-link" href="scales">Шкалы и результаты</NavLink>
        <NavLink class="nav-link" href="feedback">Обратная связь</NavLink>
    }

    @if (Auth.CanManageTests)
    {
        <NavLink class="nav-link" href="tests">Конструктор тестов</NavLink>
    }

    @if (Auth.IsAdmin)
    {
        <NavLink class="nav-link" href="admin">Администрирование</NavLink>
    }
</nav>

<div class="side-session">
    <span>@Auth.ProfileTitle</span>
    <small>@Auth.ProfileSubtitle</small>
</div>

@code {
    protected override void OnInitialized()
    {
        Auth.Changed += StateHasChanged;
    }

    public void Dispose()
    {
        Auth.Changed -= StateHasChanged;
    }
}

