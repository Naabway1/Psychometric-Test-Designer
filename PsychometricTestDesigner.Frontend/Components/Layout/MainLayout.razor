@inherits LayoutComponentBase
@implements IDisposable
@inject AuthState Auth
@inject NavigationManager Navigation

@if (!Auth.IsAuthenticated)
{
    <section class="auth-shell">
        @Body
    </section>
}
else
{
    <div class="shell">
        <aside class="side">
            <NavMenu />
        </aside>

        <main class="main">
            <header class="topbar">
                <div class="topbar-title">
                    <strong>ГБПОУ "КТК"</strong>
                    <span>Система анализа и аналитики климата в учебном коллективе</span>
                </div>
                <div class="session">
                    <span class="badge">@Auth.RoleLabel</span>
                    <button class="btn-secondary" type="button" @onclick="Logout">Выйти</button>
                </div>
            </header>

            <section class="workspace">
                @Body
            </section>
        </main>
    </div>
}

@code {
    protected override void OnInitialized()
    {
        Auth.Changed += StateHasChanged;
    }

    private void Logout()
    {
        Auth.Clear();
        Navigation.NavigateTo("/");
    }

    public void Dispose()
    {
        Auth.Changed -= StateHasChanged;
    }
}

