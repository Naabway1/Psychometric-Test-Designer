@page "/feedback"
@inject ApiClient Api
@inject AuthState Auth
@inject IJSRuntime JS

<PageTitle>Обратная связь</PageTitle>

<div class="page-title">
    <div>
        <h1>Обратная связь студентов</h1>
        <p>Текстовые сообщения, темы и эмоциональная тональность с привязкой к студенту и группе.</p>
    </div>
</div>

@if (!Auth.IsAuthenticated)
{
    <section class="panel">
        <h2>Нужен вход</h2>
        <p>Войдите как студент или психолог.</p>
    </section>
}
else if (Auth.IsStudent)
{
    <section class="panel">
        <h2>Отправить обратную связь</h2>
        <form @onsubmit="SubmitFeedback" @onsubmit:preventDefault>
            <div class="form-grid">
                <div class="field">
                    <label>Сообщение</label>
                    <textarea rows="8" @bind="studentFeedback"></textarea>
                </div>
                <div class="button-row">
                    <button class="btn-primary" type="submit" disabled="@busy">Отправить</button>
                </div>
            </div>
        </form>
    </section>
}
else if (!Auth.IsPsychologist)
{
    <section class="panel">
        <h2>Доступ ограничен</h2>
        <p>Просмотр обратной связи с ФИО студентов доступен только психологу.</p>
    </section>
}
else
{
    @if (allTrend != null)
    {
        <div class="grid cols-3">
            <section class="panel">
                <h2>Сообщений</h2>
                <div class="metric">
                    <span>Последние записи</span>
                    <strong>@allTrend.TotalMessages</strong>
                </div>
            </section>
            <section class="panel">
                <h2>Средняя тональность</h2>
                <div class="metric">
                    <span>Все группы</span>
                    <strong>@Math.Round(allTrend.AverageSentiment, 1)</strong>
                </div>
            </section>
            <section class="panel">
                <h2>Главные темы</h2>
                @foreach (var topic in allTrend.Topics.Take(3))
                {
                    <div class="metric">
                        <span>@RuText.Fix(topic.Topic)</span>
                        <strong>@topic.Count</strong>
                    </div>
                }
            </section>
        </div>

        <section class="panel" style="margin-top:14px">
            <h2>Последние сообщения по всем группам</h2>
            <table class="table">
                <thead>
                    <tr>
                        <th>Студент</th>
                        <th>Группа</th>
                        <th>Тональность</th>
                        <th>Темы</th>
                        <th>Сообщение</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var message in allTrend.RecentMessages)
                    {
                        <tr>
                            <td>@RuText.Fix(message.StudentFullName)</td>
                            <td>@RuText.Fix(message.GroupName)</td>
                            <td>@Math.Round(message.SentimentScore, 1)</td>
                            <td>@string.Join(", ", message.Topics.Select(RuText.Fix))</td>
                            <td>@RuText.Fix(message.Text)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>
    }

    <section class="panel" style="margin-top:14px">
        <div class="field">
            <label>Группа для детализации</label>
            <select value="@selectedGroupId" @onchange="ChangeGroup">
                @foreach (var group in groups)
                {
                    <option value="@group.GroupId">@RuText.Fix(group.GroupName)</option>
                }
            </select>
        </div>
    </section>

    @if (trend != null)
    {
        <div class="grid chart-layout" style="margin-top:14px">
            <section class="panel">
                <h2>Темы выбранной группы</h2>
                <p class="chart-caption">Диаграмма показывает, какие темы чаще встречаются в последних сообщениях выбранной группы. Она помогает быстро увидеть основные источники напряжения или поддержки в обратной связи студентов.</p>
                <div class="chart-box">
                    <canvas id="feedbackTopicsChart"></canvas>
                </div>
            </section>
            <section class="panel">
                <h2>Последние сообщения группы</h2>
                @foreach (var message in trend.RecentMessages)
                {
                    <div class="message-card">
                        <div class="message-meta">
                            <strong>@RuText.Fix(message.StudentFullName)</strong>
                            <span>@Math.Round(message.SentimentScore, 1)</span>
                        </div>
                        <p>@RuText.Fix(message.Text)</p>
                        <small>@string.Join(", ", message.Topics.Select(RuText.Fix))</small>
                    </div>
                }
            </section>
        </div>
    }
}

@if (!string.IsNullOrWhiteSpace(status))
{
    <section class="panel" style="margin-top:14px">
        <span>@status</span>
    </section>
}

@code {
    private List<GroupDto> groups = new();
    private GroupFeedbackTrend? allTrend;
    private GroupFeedbackTrend? trend;
    private int selectedGroupId;
    private string studentFeedback = string.Empty;
    private string? status;
    private bool busy;
    private bool chartsPending;

    protected override async Task OnInitializedAsync()
    {
        if (Auth.IsPsychologist)
        {
            groups = await Api.GetGroupsAsync();
            selectedGroupId = groups.FirstOrDefault()?.GroupId ?? 0;
            allTrend = await Api.GetAllFeedbackTrendAsync();
            await LoadTrend();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (chartsPending && trend != null)
        {
            chartsPending = false;
            await JS.InvokeVoidAsync("ptdCharts.bar", "feedbackTopicsChart",
                trend.Topics.Select(x => RuText.Fix(x.Topic)).ToArray(),
                trend.Topics.Select(x => x.Count).ToArray(),
                "Количество");
        }
    }

    private async Task ChangeGroup(ChangeEventArgs args)
    {
        selectedGroupId = int.TryParse(args.Value?.ToString(), out var value) ? value : 0;
        await LoadTrend();
    }

    private async Task LoadTrend()
    {
        trend = selectedGroupId > 0 ? await Api.GetFeedbackTrendAsync(selectedGroupId) : null;
        status = trend == null ? Api.LastError : null;
        chartsPending = true;
    }

    private async Task SubmitFeedback()
    {
        if (string.IsNullOrWhiteSpace(studentFeedback))
        {
            status = "Введите сообщение.";
            return;
        }

        busy = true;
        var result = await Api.SubmitFeedbackAsync(studentFeedback);
        status = result == null ? Api.LastError : "Сообщение отправлено.";
        studentFeedback = string.Empty;
        busy = false;
    }
}
