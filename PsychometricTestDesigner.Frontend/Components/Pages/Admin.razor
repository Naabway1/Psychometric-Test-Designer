@page "/admin"
@inject ApiClient Api
@inject AuthState Auth

<PageTitle>Админка</PageTitle>

<div class="page-title">
    <div>
        <h1>Административная панель</h1>
        <p>Группы, токены регистрации и быстрый демо-опрос для демонстрации системы.</p>
    </div>
    <span class="badge">@Auth.RoleLabel</span>
</div>

@if (!Auth.IsStaff)
{
    <section class="panel">
        <h2>Доступ для сотрудников</h2>
        <p>Административные действия доступны только сотрудникам.</p>
    </section>
}
else
{
    <div class="grid cols-3">
        <section class="panel">
            <h2>Пользователи</h2>
            <div class="metric"><span>Всего</span><strong>@(analytics?.TotalUsers ?? 0)</strong></div>
            <div class="metric"><span>Студенты</span><strong>@(analytics?.TotalStudents ?? 0)</strong></div>
        </section>
        <section class="panel">
            <h2>Опросы</h2>
            <div class="metric"><span>Тестов</span><strong>@(analytics?.TotalTests ?? 0)</strong></div>
            <div class="metric"><span>Прохождений</span><strong>@(analytics?.TotalTestsTaken ?? 0)</strong></div>
        </section>
        <section class="panel">
            <h2>Активность</h2>
            <div class="metric"><span>Заполнение</span><strong>@Math.Round(analytics?.FillRate ?? 0, 1)%</strong></div>
            <div class="metric"><span>Сообщений</span><strong>@(analytics?.TotalFeedback ?? 0)</strong></div>
        </section>
    </div>

    <div class="grid cols-3" style="margin-top:14px">
        <section class="panel">
            <h2>Создать группу</h2>
            <form @onsubmit="CreateGroup" @onsubmit:preventDefault>
                <div class="form-grid">
                    <div class="field">
                        <label>Название</label>
                        <input @bind="newGroup.GroupName" />
                    </div>
                    <div class="field">
                        <label>Специализация</label>
                        <input @bind="newGroup.Specialization" />
                    </div>
                    <div class="field">
                        <label>Количество студентов</label>
                        <input type="number" min="0" @bind="newGroup.StudentCount" />
                    </div>
                    <div class="button-row">
                        <button class="btn-primary" type="submit" disabled="@busy">Создать</button>
                    </div>
                </div>
            </form>
        </section>

        <section class="panel">
            <h2>Создать токен</h2>
            <form @onsubmit="CreateToken" @onsubmit:preventDefault>
                <div class="form-grid">
                    <div class="field">
                        <label>Группа</label>
                        <select @bind="tokenRequest.GroupId">
                            @foreach (var group in groups)
                            {
                                <option value="@group.GroupId">@RuText.Fix(group.GroupName)</option>
                            }
                        </select>
                    </div>
                    <div class="field">
                        <label>Количество использований</label>
                        <input type="number" min="1" @bind="tokenRequest.NumberOfUses" />
                    </div>
                    <div class="button-row">
                        <button class="btn-primary" type="submit" disabled="@busy">Сгенерировать</button>
                    </div>
                </div>
            </form>
            @if (!string.IsNullOrWhiteSpace(createdToken))
            {
                <div class="metric">
                    <span>Токен</span>
                    <strong style="font-size:14px">@createdToken</strong>
                </div>
            }
        </section>

        <section class="panel">
            <h2>Демо-опрос</h2>
            <p>Создаёт полный опрос со шкалами стресса, благополучия, изоляции и дефицита вовлечённости.</p>
            <div class="button-row">
                <button class="btn-primary" type="button" disabled="@busy" @onclick="CreateDemoTest">Создать демо-опрос</button>
            </div>
            @if (createdTest != null)
            {
                <div class="metric">
                    <span>@RuText.Fix(createdTest.Title)</span>
                    <strong>#@createdTest.TestId</strong>
                </div>
            }
        </section>
    </div>

    <section class="panel" style="margin-top:14px">
        <h2>Открыть тест для группы</h2>
        <form @onsubmit="CreateAssignment" @onsubmit:preventDefault>
            <div class="grid cols-2">
                <div class="field">
                    <label>Тест</label>
                    <select @bind="assignmentRequest.TestId">
                        <option value="0">Выберите тест</option>
                        @foreach (var test in tests)
                        {
                            <option value="@test.TestId">@RuText.Fix(test.Title)</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label>Группа</label>
                    <select @bind="assignmentRequest.GroupId">
                        @foreach (var group in groups)
                        {
                            <option value="@group.GroupId">@RuText.Fix(group.GroupName)</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label>Открыть</label>
                    <input type="datetime-local" value="@opensAtText" @onchange="ChangeOpensAt" />
                </div>
                <div class="field">
                    <label>Закрыть</label>
                    <input type="datetime-local" value="@closesAtText" @onchange="ChangeClosesAt" />
                </div>
            </div>
            <div class="button-row">
                <button class="btn-primary" type="submit" disabled="@busy">Открыть доступ</button>
            </div>
        </form>
    </section>

    <section class="panel" style="margin-top:14px">
        <h2>Назначенные тесты</h2>
        <table class="table">
            <thead>
                <tr>
                    <th>Тест</th>
                    <th>Группа</th>
                    <th>Открыт</th>
                    <th>Закрыт</th>
                    <th>Статус</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var assignment in assignments)
                {
                    <tr>
                        <td>@RuText.Fix(assignment.TestTitle)</td>
                        <td>@RuText.Fix(assignment.GroupName)</td>
                        <td>@ToLocal(assignment.OpensAt).ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@ToLocal(assignment.ClosesAt).ToString("dd.MM.yyyy HH:mm")</td>
                        <td><span class="badge">@(assignment.IsActive ? "Открыт" : "Закрыт")</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </section>

    <section class="panel" style="margin-top:14px">
        <h2>Токены регистрации</h2>
        <table class="table">
            <thead>
                <tr>
                    <th>Токен</th>
                    <th>ID группы</th>
                    <th>Осталось использований</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var token in tokens)
                {
                    <tr>
                        <td>@token.TokenId</td>
                        <td>@token.GroupId</td>
                        <td>@token.NumberOfUses</td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
}

@if (!string.IsNullOrWhiteSpace(status))
{
    <section class="panel" style="margin-top:14px">
        <span>@status</span>
    </section>
}

@code {
    private AdminAnalytics? analytics;
    private List<GroupRiskSummary> groups = new();
    private List<TokenResponse> tokens = new();
    private List<TestSummary> tests = new();
    private List<TestAssignment> assignments = new();
    private GroupDto newGroup = new() { GroupName = "Новая группа", Specialization = "Специальность", StudentCount = 25 };
    private CreateTokenRequest tokenRequest = new() { NumberOfUses = 30 };
    private CreateTestAssignment assignmentRequest = new();
    private string opensAtText = LocalNow.AddHours(-1).ToString("yyyy-MM-ddTHH:mm");
    private string closesAtText = LocalNow.AddDays(1).ToString("yyyy-MM-ddTHH:mm");
    private FullTestResponse? createdTest;
    private string? createdToken;
    private string? status;
    private bool busy;

    private static DateTime LocalNow => DateTime.UtcNow.AddHours(5);

    private static DateTime ToLocal(DateTime value) => value.Kind == DateTimeKind.Local
        ? value
        : value.AddHours(5);

    protected override async Task OnInitializedAsync()
    {
        if (Auth.IsStaff)
        {
            await Load();
        }
    }

    private async Task Load()
    {
        analytics = await Api.GetAdminAnalyticsAsync();
        groups = await Api.GetRiskSummariesAsync();
        tokens = await Api.GetTokensAsync();
        tests = await Api.GetTestsAsync();
        assignments = await Api.GetTestAssignmentsAsync();
        tokenRequest.GroupId = groups.FirstOrDefault()?.GroupId ?? tokenRequest.GroupId;
        if (assignmentRequest.GroupId <= 0)
        {
            assignmentRequest.GroupId = groups.FirstOrDefault()?.GroupId ?? assignmentRequest.GroupId;
        }

        if (assignmentRequest.TestId <= 0)
        {
            assignmentRequest.TestId = tests.FirstOrDefault()?.TestId ?? assignmentRequest.TestId;
        }
    }

    private async Task CreateGroup()
    {
        busy = true;
        var result = await Api.CreateGroupAsync(newGroup);
        status = result == null ? Api.LastError : $"Группа «{RuText.Fix(result.GroupName)}» создана.";
        await Load();
        busy = false;
    }

    private async Task CreateToken()
    {
        busy = true;
        var result = await Api.CreateTokenAsync(tokenRequest);
        createdToken = result?.TokenId;
        status = result == null ? Api.LastError : "Токен создан.";
        await Load();
        busy = false;
    }

    private async Task CreateDemoTest()
    {
        busy = true;
        createdTest = await Api.CreateDemoTestAsync(Auth.UserId);
        status = createdTest == null ? Api.LastError : "Демо-опрос создан.";
        if (createdTest != null)
        {
            assignmentRequest.TestId = createdTest.TestId;
        }
        await Load();
        busy = false;
    }

    private async Task CreateAssignment()
    {
        if (!DateTime.TryParse(opensAtText, out var opensAt) || !DateTime.TryParse(closesAtText, out var closesAt))
        {
            status = "Проверьте даты открытия и закрытия.";
            return;
        }

        busy = true;
        assignmentRequest.OpensAt = opensAt;
        assignmentRequest.ClosesAt = closesAt;
        var result = await Api.CreateTestAssignmentAsync(assignmentRequest);
        status = result == null
            ? Api.LastError
            : $"Тест «{RuText.Fix(result.TestTitle)}» открыт для группы {RuText.Fix(result.GroupName)}.";
        await Load();
        busy = false;
    }

    private void ChangeOpensAt(ChangeEventArgs args)
    {
        opensAtText = args.Value?.ToString() ?? string.Empty;
    }

    private void ChangeClosesAt(ChangeEventArgs args)
    {
        closesAtText = args.Value?.ToString() ?? string.Empty;
    }
}
