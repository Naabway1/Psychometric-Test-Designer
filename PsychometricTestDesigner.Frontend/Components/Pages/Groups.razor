@page "/groups"
@inject ApiClient Api
@inject AuthState Auth
@inject IJSRuntime JS

<PageTitle>Аналитика групп</PageTitle>

<div class="page-title">
    <div>
        <h1>Аналитика учебных групп</h1>
        <p>Агрегированная картина состояния учебных групп по результатам тестирования.</p>
    </div>
</div>

@if (!Auth.IsPsychologist)
{
    <section class="panel">
        <h2>Доступ ограничен</h2>
        <p>Агрегированные психологические показатели доступны только психологу.</p>
    </section>
}
else
{
    <section class="panel">
        <div class="section-head">
            <div>
                <h2>Выбранная группа</h2>
                <p class="muted">Здесь остаются только графики и таблицы по одной группе; общий рейтинг вынесен в раздел групп риска.</p>
            </div>
            <div class="field group-picker">
                <label>Группа</label>
                <select value="@selectedGroupId" @onchange="ChangeGroup">
                    @foreach (var group in summaries)
                    {
                        <option value="@group.GroupId">@RuText.Fix(group.GroupName)</option>
                    }
                </select>
            </div>
        </div>
    </section>

    @if (selectedGroup != null)
    {
        <div class="grid chart-stack" style="margin-top:14px">
            <section class="panel">
                <h2>@RuText.Fix(selectedGroup.GroupName): динамика метрик</h2>
                <p class="chart-caption">График показывает средние значения метрик выбранной группы по датам тестирования. Он помогает увидеть, какие показатели усиливаются или снижаются после повторных измерений.</p>
                <div class="chart-box">
                    <canvas id="groupHistoryChart"></canvas>
                </div>
            </section>

            <section class="panel">
                <h2>@RuText.Fix(selectedGroup.GroupName): распределение шкал</h2>
                <p class="chart-caption">Диаграмма показывает, сколько результатов студентов попало в низкий, средний и высокий диапазон по каждой шкале. Цвета учитывают тип шкалы: для рисковых высокие значения тревожнее, для позитивных высокие значения благоприятнее.</p>
                <div class="chart-box">
                    <canvas id="groupScaleChart"></canvas>
                </div>
            </section>
        </div>

        <section class="panel" style="margin-top:14px">
            <h2>Средние показатели группы</h2>
            <div class="table-shell">
                <table class="table table-fill">
                    <thead>
                        <tr>
                            <th>Метрика</th>
                            <th>Тип</th>
                            <th>Среднее</th>
                            <th>Студентов в расчете</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var metric in metrics)
                        {
                            <tr>
                                <td>@RuText.Fix(metric.MetricName)</td>
                                <td>@MetricType(metric.IsPositive)</td>
                                <td>@Math.Round(metric.AverageValue, 1)</td>
                                <td>@metric.UsersCount</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
}

@if (!string.IsNullOrWhiteSpace(status))
{
    <section class="panel" style="margin-top:14px">
        <span>@status</span>
    </section>
}

@code {
    private List<GroupRiskSummary> summaries = new();
    private List<GroupMetric> metrics = new();
    private List<GroupMetricHistoryPoint> history = new();
    private List<GroupScaleDistribution> distribution = new();
    private GroupRiskSummary? selectedGroup;
    private int selectedGroupId;
    private string? status;
    private bool chartsPending;

    protected override async Task OnInitializedAsync()
    {
        if (Auth.IsPsychologist)
        {
            summaries = await Api.GetRiskSummariesAsync();
            selectedGroup = summaries.FirstOrDefault();
            if (selectedGroup != null)
            {
                selectedGroupId = selectedGroup.GroupId;
                await LoadSelected();
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (chartsPending)
        {
            chartsPending = false;
            await RenderCharts();
        }
    }

    private async Task ChangeGroup(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var groupId))
        {
            return;
        }

        selectedGroupId = groupId;
        selectedGroup = summaries.FirstOrDefault(x => x.GroupId == groupId);
        await LoadSelected();
    }

    private async Task LoadSelected()
    {
        if (selectedGroup == null)
        {
            return;
        }

        metrics = await Api.GetGroupMetricsAsync(selectedGroup.GroupId);
        history = await Api.GetMetricHistoryAsync(selectedGroup.GroupId);
        distribution = await Api.GetScaleDistributionAsync(selectedGroup.GroupId);
        status = Api.LastError;
        chartsPending = true;
    }

    private async Task RenderCharts()
    {
        var labels = history
            .Select(x => x.Date.Date)
            .Distinct()
            .OrderBy(x => x)
            .Select(x => x.ToString("dd.MM"))
            .ToArray();

        var series = history
            .GroupBy(x => new { Name = RuText.Fix(x.MetricName), x.IsPositive })
            .Select(g => new
            {
                label = g.Key.Name,
                data = labels.Select(label =>
                {
                    var point = g.FirstOrDefault(x => x.Date.ToString("dd.MM") == label);
                    return point == null ? 0 : Math.Round(point.AverageValue, 1);
                }).ToArray(),
                borderColor = g.Key.IsPositive ? "#22c55e" : "#ef4444"
            }).ToArray();

        await JS.InvokeVoidAsync("ptdCharts.line", "groupHistoryChart", labels, series);

        await JS.InvokeVoidAsync("ptdCharts.groupedBar", "groupScaleChart",
            distribution.Select(x => RuText.Fix(x.ScaleName)).ToArray(),
            new[]
            {
                new { label = "Низкие", data = distribution.Select(x => x.LowCount).ToArray(), backgroundColor = distribution.Select(x => LevelColor("low", x.IsPositive)).ToArray() },
                new { label = "Средние", data = distribution.Select(x => x.MediumCount).ToArray(), backgroundColor = distribution.Select(x => LevelColor("medium", x.IsPositive)).ToArray() },
                new { label = "Высокие", data = distribution.Select(x => x.HighCount).ToArray(), backgroundColor = distribution.Select(x => LevelColor("high", x.IsPositive)).ToArray() }
            });
    }

    private static string MetricType(bool isPositive) => isPositive ? "Позитивная" : "Рисковая";

    private static string LevelColor(string level, bool isPositive) => level switch
    {
        "low" => isPositive ? "#ef4444" : "#22c55e",
        "medium" => "#facc15",
        "high" => isPositive ? "#22c55e" : "#ef4444",
        _ => "#8b5cf6"
    };
}
