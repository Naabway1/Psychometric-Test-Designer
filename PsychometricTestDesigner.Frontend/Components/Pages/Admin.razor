@page "/admin"
@inject ApiClient Api
@inject AuthState Auth

<PageTitle>Администрирование</PageTitle>

<div class="page-title">
    <div>
        <h1>Администрирование</h1>
        <p>Базовое управление группами и кодами регистрации без доступа к психологическим результатам.</p>
    </div>
</div>

@if (!Auth.IsAdmin)
{
    <section class="panel">
        <h2>Доступ ограничен</h2>
        <p>Раздел предназначен только для администратора системы.</p>
    </section>
}
else
{
    <div class="grid cols-3">
        <section class="panel">
            <h2>Пользователи</h2>
            <div class="metric"><span>Всего</span><strong>@(analytics?.TotalUsers ?? 0)</strong></div>
            <div class="metric"><span>Студенты</span><strong>@(analytics?.TotalStudents ?? 0)</strong></div>
        </section>
        <section class="panel">
            <h2>Учебные группы</h2>
            <div class="metric"><span>Групп</span><strong>@groups.Count</strong></div>
            <div class="metric"><span>Кодов регистрации</span><strong>@tokens.Count</strong></div>
        </section>
        <section class="panel">
            <h2>Система тестирования</h2>
            <div class="metric"><span>Тестов</span><strong>@(analytics?.TotalTests ?? 0)</strong></div>
            <div class="metric"><span>Вариантов ответов</span><strong>@(analytics?.TotalAnswers ?? 0)</strong></div>
        </section>
    </div>

    <div class="grid cols-2" style="margin-top:14px">
        <section class="panel">
            <h2>Создать группу</h2>
            <form @onsubmit="CreateGroup" @onsubmit:preventDefault>
                <div class="form-grid">
                    <div class="field">
                        <label>Название</label>
                        <input @bind="newGroup.GroupName" />
                    </div>
                    <div class="field">
                        <label>Специальность</label>
                        <input @bind="newGroup.Specialization" />
                    </div>
                    <div class="field">
                        <label>Плановое количество студентов</label>
                        <input type="number" min="0" @bind="newGroup.StudentCount" />
                    </div>
                    <div class="button-row">
                        <button class="btn-primary" type="submit" disabled="@busy">Создать группу</button>
                    </div>
                </div>
            </form>
        </section>

        <section class="panel">
            <h2>Создать код регистрации</h2>
            <form @onsubmit="CreateToken" @onsubmit:preventDefault>
                <div class="form-grid">
                    <div class="field">
                        <label>Группа</label>
                        <select @bind="tokenRequest.GroupId">
                            @foreach (var group in groups)
                            {
                                <option value="@group.GroupId">@RuText.Fix(group.GroupName)</option>
                            }
                        </select>
                    </div>
                    <div class="field">
                        <label>Количество использований</label>
                        <input type="number" min="1" @bind="tokenRequest.NumberOfUses" />
                    </div>
                    <div class="button-row">
                        <button class="btn-primary" type="submit" disabled="@busy">Сгенерировать код</button>
                    </div>
                </div>
            </form>
            @if (!string.IsNullOrWhiteSpace(createdToken))
            {
                <div class="metric">
                    <span>Код регистрации</span>
                    <strong class="small-strong">@createdToken</strong>
                </div>
            }
        </section>
    </div>

    <section class="panel" style="margin-top:14px">
        <h2>Коды регистрации</h2>
        <table class="table">
            <thead>
                <tr>
                    <th>Код</th>
                    <th>ID группы</th>
                    <th>Осталось использований</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var token in tokens)
                {
                    <tr>
                        <td>@token.TokenId</td>
                        <td>@token.GroupId</td>
                        <td>@token.NumberOfUses</td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
}

@if (!string.IsNullOrWhiteSpace(status))
{
    <section class="panel" style="margin-top:14px">
        <span>@status</span>
    </section>
}

@code {
    private AdminAnalytics? analytics;
    private List<GroupDto> groups = new();
    private List<TokenResponse> tokens = new();
    private GroupDto newGroup = new() { GroupName = "Новая группа", Specialization = "Специальность", StudentCount = 25 };
    private CreateTokenRequest tokenRequest = new() { NumberOfUses = 30 };
    private string? createdToken;
    private string? status;
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        if (Auth.IsAdmin)
        {
            await Load();
        }
    }

    private async Task Load()
    {
        analytics = await Api.GetAdminAnalyticsAsync();
        groups = await Api.GetGroupsAsync();
        tokens = await Api.GetTokensAsync();
        tokenRequest.GroupId = groups.FirstOrDefault()?.GroupId ?? tokenRequest.GroupId;
    }

    private async Task CreateGroup()
    {
        busy = true;
        var result = await Api.CreateGroupAsync(newGroup);
        status = result == null ? Api.LastError : $"Группа «{RuText.Fix(result.GroupName)}» создана.";
        await Load();
        busy = false;
    }

    private async Task CreateToken()
    {
        busy = true;
        var result = await Api.CreateTokenAsync(tokenRequest);
        createdToken = result?.TokenId;
        status = result == null ? Api.LastError : "Код регистрации создан.";
        await Load();
        busy = false;
    }
}
