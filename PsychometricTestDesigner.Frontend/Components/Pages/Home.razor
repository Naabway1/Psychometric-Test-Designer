@page "/"
@inject ApiClient Api
@inject AuthState Auth
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Авторизация</PageTitle>

@if (!Auth.IsAuthenticated)
{
    <div class="auth-page">
        <section class="panel auth-card">
            <div class="auth-card-head">
                <div class="brand auth-brand">
                    <div class="brand-mark">IT</div>
                    <div>
                        <strong>ГБПОУ "КТК"</strong>
                        <span>Система анализа климата в учебном коллективе</span>
                    </div>
                </div>
                <button class="icon-button theme-toggle" type="button" title="@ThemeButtonTitle" aria-label="@ThemeButtonTitle" @onclick="ToggleTheme">
                    <span aria-hidden="true">@ThemeIcon</span>
                </button>
            </div>

            <h1>Авторизация</h1>
            <form @onsubmit="Login" @onsubmit:preventDefault>
                <div class="form-grid">
                    <div class="field">
                        <label>Логин</label>
                        <input @bind="login.Login" autocomplete="username" />
                    </div>
                    <div class="field">
                        <label>Пароль</label>
                        <input type="password" @bind="login.Password" autocomplete="current-password" />
                    </div>
                    <div class="auth-actions">
                        <button class="btn-primary" type="submit" disabled="@busy">Войти</button>
                        <a class="btn-secondary" href="/register">Зарегистрироваться</a>
                    </div>
                </div>
            </form>

            @if (!string.IsNullOrWhiteSpace(status))
            {
                <p class="auth-status">@status</p>
            }
        </section>
    </div>
}
else
{
    <PageTitle>Панель управления</PageTitle>

    <div class="page-title">
        <div>
            <h1>Панель управления</h1>
            <p>Доступные разделы зависят от вашей роли в системе.</p>
        </div>
    </div>

    <div class="grid cols-3">
        @foreach (var module in VisibleModules)
        {
            <section class="panel">
                <h2>@module.Title</h2>
                <p>@module.Text</p>
                <div class="button-row">
                    <button class="btn-secondary" type="button" @onclick="() => Navigation.NavigateTo(module.Url)">Открыть</button>
                </div>
            </section>
        }
    </div>
}

@code {
    private readonly LoginRequest login = new();
    private bool busy;
    private string? status;

    private IEnumerable<(string Title, string Text, string Url)> VisibleModules
    {
        get
        {
            yield return ("Панель управления", "Главный экран с доступными разделами системы.", "/");

            if (Auth.IsStudent)
            {
                yield return ("Личный кабинет", "Доступные тестирования, персональные шкалы и текущие метрики.", "/student");
            }

            if (Auth.IsPsychologist)
            {
                yield return ("Аналитика групп", "Агрегированные показатели учебных групп и динамика метрик.", "/groups");
                yield return ("Группы риска", "Ранжирование групп по интегральному риску и проблемным метрикам.", "/risks");
                yield return ("Вовлеченность", "Активность прохождения тестов и социальный климат по группам.", "/engagement");
                yield return ("Шкалы и результаты", "Распределение шкал и индивидуальные сводки студентов.", "/scales");
                yield return ("Обратная связь", "Темы, тональность и последние сообщения студентов.", "/feedback");
                yield return ("Уведомления", "Сводка событий, требующих внимания психолога, сформированная на основе групповых показателей и пороговых значений.", "/triggers");
            }

            if (Auth.CanManageTests)
            {
                yield return ("Конструктор тестов", "Создание тестов, шкал, метрик и настройка доступности.", "/tests");
            }

            if (Auth.IsAdmin)
            {
                yield return ("Администрирование", "Группы и коды регистрации без доступа к психологическим результатам.", "/admin");
            }
        }
    }

    private async Task Login()
    {
        busy = true;
        status = null;

        var result = await Api.LoginAsync(login);
        if (result == null)
        {
            status = Api.LastError ?? "Не удалось войти. Проверьте логин и пароль.";
        }
        else
        {
            status = null;
            Navigation.NavigateTo("/");
        }

        busy = false;
    }

    private string theme = "dark";
    private string ThemeIcon => theme == "light" ? "☀" : "☾";
    private string ThemeButtonTitle => theme == "light" ? "Включить темную тему" : "Включить светлую тему";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            theme = await JS.InvokeAsync<string>("ptdTheme.get");
            StateHasChanged();
        }
    }

    private async Task ToggleTheme()
    {
        theme = await JS.InvokeAsync<string>("ptdTheme.toggle");
    }
}
