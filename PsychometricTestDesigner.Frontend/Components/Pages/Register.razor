@page "/register"
@inject ApiClient Api
@inject AuthState Auth
@inject NavigationManager Navigation

<PageTitle>Регистрация</PageTitle>

@if (!Auth.IsAuthenticated)
{
    <div class="auth-page">
        <section class="panel auth-card">
            <div class="brand auth-brand">
                <div class="brand-mark">IT</div>
                <div>
                    <strong>ГБПОУ "КТК"</strong>
                    <span>Система анализа климата в учебном коллективе</span>
                </div>
            </div>

            <h1>Регистрация</h1>
            <form @onsubmit="RegisterAsync" @onsubmit:preventDefault>
                <div class="form-grid">
                    <div class="field">
                        <label>Логин</label>
                        <input @bind="register.Login" autocomplete="username" />
                    </div>
                    <div class="field">
                        <label>Пароль</label>
                        <input type="password" @bind="register.Password" autocomplete="new-password" />
                    </div>
                    <div class="field">
                        <label>Код приглашения</label>
                        <input @bind="register.Token" autocomplete="off" />
                    </div>
                    <div class="button-row">
                        <button class="btn-primary" type="submit" disabled="@busy">Зарегистрироваться</button>
                    </div>
                </div>
            </form>

            @if (!string.IsNullOrWhiteSpace(status))
            {
                <p class="auth-status">@status</p>
            }
        </section>
    </div>
}
else
{
    <PageTitle>Пульт системы</PageTitle>

    <div class="page-title">
        <div>
            <h1>Пульт системы</h1>
            <p>Доступные разделы зависят от вашей роли в системе.</p>
        </div>
        <span class="badge">@Auth.RoleLabel</span>
    </div>

    <div class="grid cols-3">
        @foreach (var module in VisibleModules)
        {
            <section class="panel">
                <h2>@module.Title</h2>
                <p>@module.Text</p>
                <div class="button-row">
                    <button class="btn-secondary" type="button" @onclick="() => Navigation.NavigateTo(module.Url)">Открыть</button>
                </div>
            </section>
        }
    </div>
}

@code {
    private readonly RegisterRequest register = new();
    private bool busy;
    private string? status;

    private IEnumerable<(string Title, string Text, string Url)> VisibleModules
    {
        get
        {
            yield return ("Пульт", "Главный экран с доступными модулями системы.", "/");

            if (Auth.IsStudent)
            {
                yield return ("Личная аналитика", "Опросы, персональные шкалы, метрики и вклад в состояние группы.", "/student");
                yield return ("Обратная связь", "Сообщение о состоянии, проблемах или поддерживающих факторах.", "/feedback");
            }

            if (Auth.IsStaff)
            {
                yield return ("Эмоциональная карта", "Агрегированное состояние учебных групп без раскрытия отдельных студентов.", "/groups");
                yield return ("Группы риска", "Ранжирование групп по интегральному риску и проблемным метрикам.", "/risks");
                yield return ("Вовлечённость", "Активность, заполнение опросов и социальный климат вместо модуля расписания.", "/engagement");
                yield return ("Шкалы", "Распределение низких, средних и высоких значений по шкалам.", "/scales");
                yield return ("NLP-связь", "Темы, тональность и последние сообщения обратной связи.", "/feedback");
                yield return ("Триггеры", "Автоматические сигналы, когда показатели группы переходят пороги.", "/triggers");
            }

            if (Auth.Role.Equals("Admin", StringComparison.OrdinalIgnoreCase))
            {
                yield return ("Админка", "Группы, токены регистрации и демо-опрос для защиты.", "/admin");
            }
        }
    }

    private async Task RegisterAsync()
    {
        busy = true;
        status = null;

        var result = await Api.RegisterStudentAsync(register);
        if (result == null)
        {
            status = Api.LastError ?? "Не удалось зарегистрироваться. Проверьте данные.";
        }
        else
        {
            status = null;
            Navigation.NavigateTo("/");
        }

        busy = false;
    }
}
