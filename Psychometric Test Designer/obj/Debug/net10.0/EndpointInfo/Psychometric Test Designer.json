{
  "openapi": "3.1.1",
  "info": {
    "title": "Psychometric Test Designer | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://localhost:7111"
    },
    {
      "url": "http://localhost:5186"
    }
  ],
  "paths": {
    "/test-db": {
      "get": {
        "tags": [
          "Psychometric Test Designer"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/User"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnswerOption": {
        "type": "object",
        "properties": {
          "answerId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "text": {
            "type": "string"
          },
          "value": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "questionId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "question": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Question"
              }
            ]
          }
        }
      },
      "Group": {
        "type": "object",
        "properties": {
          "groupId": {
            "type": "string"
          },
          "specialization": {
            "maxLength": 100,
            "type": "string"
          },
          "users": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/User"
            }
          }
        }
      },
      "Metric": {
        "type": "object",
        "properties": {
          "metricId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "name": {
            "maxLength": 100,
            "type": "string"
          },
          "testScaleMetrics": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TestScaleMetric"
            }
          }
        }
      },
      "Question": {
        "required": [
          "text"
        ],
        "type": "object",
        "properties": {
          "questionId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "text": {
            "type": "string"
          },
          "testId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "test": {
            "$ref": "#/components/schemas/Test"
          },
          "answerOptions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AnswerOption"
            }
          },
          "questionScales": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QuestionScale"
            }
          }
        }
      },
      "QuestionScale": {
        "type": "object",
        "properties": {
          "questionId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "scaleId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "weight": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "question": {
            "$ref": "#/components/schemas/Question"
          },
          "scale": {
            "$ref": "#/components/schemas/Scale"
          }
        }
      },
      "Scale": {
        "type": "object",
        "properties": {
          "scaleId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "name": {
            "maxLength": 100,
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "questionScales": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QuestionScale"
            }
          },
          "testScaleMetrics": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TestScaleMetric"
            }
          }
        }
      },
      "Test": {
        "type": "object",
        "properties": {
          "testId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "title": {
            "maxLength": 255,
            "type": "string"
          },
          "createdById": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "createdBy": {
            "$ref": "#/components/schemas/User"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "questions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Question"
            }
          }
        }
      },
      "TestScaleMetric": {
        "type": "object",
        "properties": {
          "testId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "scaleId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "metricId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "weight": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "test": {
            "$ref": "#/components/schemas/Test"
          },
          "scale": {
            "$ref": "#/components/schemas/Scale"
          },
          "metric": {
            "$ref": "#/components/schemas/Metric"
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "userId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "login": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "groupId": {
            "type": "string"
          },
          "group": {
            "$ref": "#/components/schemas/Group"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "metrics": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UserMetric"
            }
          }
        }
      },
      "UserMetric": {
        "type": "object",
        "properties": {
          "userId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "metricId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "value": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          },
          "metric": {
            "$ref": "#/components/schemas/Metric"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Psychometric Test Designer"
    }
  ]
}